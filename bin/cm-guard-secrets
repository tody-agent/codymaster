#!/usr/bin/env bash
# cm-guard-secrets — PreToolUse hook: scan stdin for secrets before Write/Edit
# Reads the tool_input JSON from stdin and checks the content for common secret patterns.

set -euo pipefail

INPUT=$(cat)

FILE_PATH=$(echo "$INPUT" | grep -o '"file_path"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 | sed 's/.*"file_path"[[:space:]]*:[[:space:]]*"//;s/"$//' 2>/dev/null || true)

CONTENT=$(echo "$INPUT" | grep -o '"content"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 2>/dev/null || true)
NEW_STR=$(echo "$INPUT" | grep -o '"new_str"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 2>/dev/null || true)

CHECK_TEXT="${CONTENT}${NEW_STR}"

if [ -z "$CHECK_TEXT" ]; then
  exit 0
fi

PATTERNS=(
  'AKIA[0-9A-Z]{16}'
  'sk-[a-zA-Z0-9]{20,}'
  'ghp_[a-zA-Z0-9]{36}'
  'gho_[a-zA-Z0-9]{36}'
  'glpat-[a-zA-Z0-9\-]{20,}'
  'xox[bpas]-[a-zA-Z0-9\-]+'
  'sk_live_[a-zA-Z0-9]{20,}'
  'rk_live_[a-zA-Z0-9]{20,}'
  'SG\.[a-zA-Z0-9_\-]{22}\.[a-zA-Z0-9_\-]{43}'
)

for pattern in "${PATTERNS[@]}"; do
  if echo "$CHECK_TEXT" | grep -qE "$pattern" 2>/dev/null; then
    echo "[cm-guard-secrets] WARNING: Possible secret detected in ${FILE_PATH:-unknown file}. Pattern: ${pattern}" >&2
    echo '{"decision":"block","reason":"Secret pattern detected by cm-guard-secrets. Review the content before writing."}'
    exit 0
  fi
done

exit 0

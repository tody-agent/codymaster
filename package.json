{
  "name": "codymaster",
  "version": "6.1.0",
  "description": "CodyMaster v2.0 — 39 focused skills with token budgets, handoff JSON, per-project learnings. AI-powered coding skill kit for Claude, Cursor, Gemini & more.",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/tody-agent/codymaster.git"
  },
  "homepage": "https://cody.todyle.com",
  "bugs": {
    "url": "https://github.com/tody-agent/codymaster/issues"
  },
  "bin": {
    "cm": "dist/index.js",
    "codymaster": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "ts-node src/index.ts",
    "test:gate": "vitest run --reporter=verbose",
    "test:gate:kit": "npm run build && npm run validate:skills && npm run check:skills && vitest run --reporter=verbose",
    "gate:secrets": "node scripts/gate-0-secrets.js",
    "gate:hygiene": "node scripts/gate-0-repo-hygiene.js",
    "gate:fix": "node scripts/security-fixer.js --fix",
    "gate:check": "node scripts/security-fixer.js",
    "gate:syntax": "node scripts/gate-1-syntax.js",
    "gate:dist": "node scripts/gate-5-dist-verify.js",
    "gate:smoke": "node scripts/gate-6-smoke-test.js",
    "deploy": "npm run gate:secrets && npm run gate:hygiene && npm run gate:syntax && npm run test:gate:kit && npm run gate:dist && npm run gate:smoke",
    "deploy:dry": "npm run gate:secrets && npm run gate:hygiene && npm run gate:syntax && npm run test:gate:kit && npm run gate:dist && echo '✅ All gates passed. Ready to deploy.'",
    "postinstall": "node scripts/postinstall.js",
    "validate:skills": "node scripts/validate-skills.mjs",
    "build:skills": "node scripts/build-skills.mjs",
    "check:skills": "node scripts/build-skills.mjs --check",
    "build:platforms": "node scripts/build-skills.mjs --platforms cursor,codex,opencode",
    "check:platforms": "node scripts/build-skills.mjs --platforms cursor,codex,opencode --check",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "keywords": [
    "ai",
    "coding",
    "skills",
    "claude",
    "cursor",
    "gemini",
    "vibe-coding",
    "developer-tools",
    "productivity",
    "cli"
  ],
  "author": "todyagent <aitodyle@gmail.com>",
  "license": "ISC",
  "type": "commonjs",
  "files": [
    "dist/",
    "scripts/",
    "skills/",
    "commands/",
    "public/",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@clack/prompts": "^1.1.0",
    "async-mutex": "^0.5.0",
    "better-sqlite3": "^12.8.0",
    "chalk": "^5.6.2",
    "chokidar": "^5.0.0",
    "commander": "^14.0.3",
    "express": "^5.2.1",
    "prompts": "^2.4.2",
    "ws": "^8.20.0",
    "yaml": "^2.8.3",
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "@types/prompts": "^2.4.9",
    "@types/ws": "^8.18.1",
    "acorn": "^8.16.0",
    "jsdom": "^29.0.1",
    "playwright": "^1.50.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "path-to-regexp": "^8.4.0"
  }
}
